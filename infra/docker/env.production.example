# Copy to the repository root as .env.production and replace all placeholder values.
DOMAIN_NAME=app.example.co.za

POSTGRES_DB=boqpro
POSTGRES_USER=boqpro
POSTGRES_PASSWORD=REPLACE_WITH_48_HEX_CHAR_DATABASE_PASSWORD
BOQPRO_DATABASE_URL=postgresql+psycopg://boqpro:REPLACE_WITH_48_HEX_CHAR_DATABASE_PASSWORD@localhost:5432/boqpro

BOQPRO_ENVIRONMENT=production
BOQPRO_DEBUG=false
BOQPRO_JWT_SECRET=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET
BOQPRO_PASSWORD_SALT=REPLACE_WITH_64_HEX_CHAR_RANDOM_SALT
BOQPRO_APP_BASE_URL=https://app.example.co.za
BOQPRO_PUBLIC_APP_URL=https://app.example.co.za
BOQPRO_CORS_ORIGINS=["https://app.example.co.za"]

# Persistent local Docker volume is used for uploaded documents and exports.
BOQPRO_STORAGE_TYPE=local

# Configure Gemini if AI-assisted parsing is required; otherwise the rule-based parser is used.
BOQPRO_LLM_PROVIDER=stub
BOQPRO_GEMINI_API_KEY=
BOQPRO_GEMINI_MODEL=gemini-2.5-flash

# Configure a real email provider before broadcasting supplier quote requests.
BOQPRO_NOTIFICATION_PROVIDER=console
BOQPRO_SMTP_HOST=
BOQPRO_SMTP_PORT=587
BOQPRO_SMTP_USERNAME=
BOQPRO_SMTP_PASSWORD=
BOQPRO_SMTP_USE_TLS=true
BOQPRO_SMTP_FROM_EMAIL=noreply@boqpro.co.za
