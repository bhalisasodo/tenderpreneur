BOQPRO_ENVIRONMENT=development
BOQPRO_OPERATOR_EMAILS=bhalisasodo10@gmail.com
BOQPRO_PUBLIC_APP_URL=http://localhost:3000
# Database: Default SQLite for zero-config local dev, or PostgreSQL for production
BOQPRO_DATABASE_URL=sqlite+aiosqlite:///./boqpro.db
# BOQPRO_DATABASE_URL=postgresql+psycopg://boqpro:boqpro@localhost:5432/boqpro

# Storage: "local" (default filesystem) or "s3"
BOQPRO_STORAGE_TYPE=local
BOQPRO_LOCAL_STORAGE_PATH=./storage
BOQPRO_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
BOQPRO_OBJECT_STORAGE_BUCKET=boqpro

# Integrations
BOQPRO_LLM_PROVIDER=stub
BOQPRO_NOTIFICATION_PROVIDER=console
# Production email delivery: set provider to email and configure SMTP credentials.
# BOQPRO_NOTIFICATION_PROVIDER=email
# BOQPRO_SMTP_HOST=smtp.example.com
# BOQPRO_SMTP_PORT=587
# BOQPRO_SMTP_USERNAME=
# BOQPRO_SMTP_PASSWORD=
# BOQPRO_SMTP_FROM_EMAIL=noreply@boqpro.co.za
# Legacy note: TENDERPRENEUR_* variables are also supported as automatic fallbacks.
