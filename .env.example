TENDERPRENEUR_ENVIRONMENT=development
# Database: Default SQLite for zero-config local dev, or PostgreSQL for production
TENDERPRENEUR_DATABASE_URL=sqlite+aiosqlite:///./tenderpreneur.db
# TENDERPRENEUR_DATABASE_URL=postgresql+psycopg://tenderpreneur:tenderpreneur@localhost:5432/tenderpreneur

# Storage: "local" (default filesystem) or "s3"
TENDERPRENEUR_STORAGE_TYPE=local
TENDERPRENEUR_LOCAL_STORAGE_PATH=./storage
TENDERPRENEUR_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
TENDERPRENEUR_OBJECT_STORAGE_BUCKET=tenderpreneur

# Integrations
TENDERPRENEUR_LLM_PROVIDER=stub
TENDERPRENEUR_NOTIFICATION_PROVIDER=console
